{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Este nombre debe ser igual al nombre del Worker en Cloudflare.
  "name": "ferrodistribuciones",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // La base de datos se crea sola en la primera publicación.
  "d1_databases": [
    { "binding": "DB", "database_name": "ferrodistribuciones-db" }
  ],
  "observability": { "enabled": true }
}
